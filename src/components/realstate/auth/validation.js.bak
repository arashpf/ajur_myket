import React, { useState, useEffect, useRef } from "react";
import {
  View,
  StyleSheet,
  ImageBackground,
  Dimensions,
  TextInput,
  TouchableOpacity,
  Keyboard,
  Platform
} from 'react-native';
import { Button, HStack, Text, Box, useToast } from 'native-base';
import axios from 'axios';
import Spinner from 'react-native-spinkit';
import AsyncStorage from '@react-native-async-storage/async-storage';
import Icon from 'react-native-vector-icons/Ionicons';
import messaging from '@react-native-firebase/messaging';
import { CommonActions } from '@react-navigation/native';

import OTPInputView from '@twotalltotems/react-native-otp-input';






const Validation = ({ route, navigation }) => {
  const toast = useToast();
  const { phone } = route.params;
  const [isLoading, setIsLoading] = useState(false);
  const [code, setCode] = useState('');
  const [deviceToken, setDeviceToken] = useState(null);
  const otpInputRef = useRef();


  
// Debug code changes
useEffect(() => {
  console.log('Current OTP code:', code); // Verify this logs correctly
}, [code]);


  useEffect(() => {


    
    const timer = setTimeout(() => {
      if (otpInputRef.current) {
        otpInputRef.current.focusField(0);
        // For Android specifically:
        if (Platform.OS === 'android') {
          Keyboard.dismiss(); // First dismiss
          setTimeout(() => otpInputRef.current?.focusField(0), 100); // Then focus
        }
      }
    }, 300);
    
    return () => clearTimeout(timer);
  }, []);


 

  useEffect(() => {
    const checkToken = async () => {
      try {
        const fcmToken = await messaging().getToken();
        if (fcmToken) {
          setDeviceToken(fcmToken);
        }
      } catch (error) {
        console.error('Error getting FCM token:', error);
      }
    };
    
    checkToken();
  }, []);

  

  const showToast = (message, type = 'error') => {
    const colors = {
      success: "green.700",
      error: "red.700",
      warning: "orange.700"
    };
    
    toast.show({
      render: () => (
        <Box bg={colors[type]} px="15" py="3" rounded="md" mb={5}>
          <Text style={{color:'white', fontSize:16}}>{message}</Text>
        </Box>
      ),
      placement: "top",
      duration: 3000
    });
  };

  const handleVerifyCode = async (newCode) => {
    Keyboard.dismiss();

    
    if (newCode.length !== 5) {
      showToast("کد تایید باید ۵ رقمی باشد", "warning");
      return;
    }

    setIsLoading(true);

    try {
      const response = await axios.post('https://api.ajur.app/auth/verify', {
        phone: phone,
        code: newCode,
        device_Token: deviceToken,
        password: 'ddr007'
      });

      if (response.data.status === 'success') {
        await AsyncStorage.multiSet([
          ['id_token', response.data.result.token],
          ['stars', JSON.stringify(response.data.stars)],
           ['name', JSON.stringify(response.data.user.name) || ''],
        ]);
        
        showToast("با موفقیت وارد شدید", "success");
        
        // navigation.navigate("RDashborad"); 

        navigation.reset({
            index: 1,
            routes: [
              { name: 'Base' },
              { name: 'RDashborad' },
            ],
          });

        // navigation.reset({
        //       index: 0,
        //       routes: [{name: 'Base'}],
        //     });
        


        // navigation.dispatch(
        //   CommonActions.reset({
        //     index: 0,
        //     routes: [{ name: 'newWorker' }], 
        //   })
        // );
      } else if (response.data.status === 'useless') {
        showToast("کد وارد شده منقضی شده است", "warning");
      } else {
        showToast("کد وارد شده اشتباه میباشد");
      }
    } catch (error) {
      console.error("Verification error:", error);
      showToast("خطا در ارتباط با سرور");
    } finally {
      setIsLoading(false);
    }
  };

  const handleResendCode = () => {
    navigation.goBack();
  };

  const formatPhoneNumber = (phone) => {
    return `${phone.substring(0, 4)}***${phone.substring(7)}`;
  };

  return (
    <View style={styles.container}>
      <HStack  px="5" py="3" justifyContent="space-between" alignItems="center" w="100%" maxW="100%">
                <HStack alignItems="center">
                  <Text color="white" fontSize="15" fontWeight="bold">
                    <Icon onPress={()=> navigation.pop()}  style={{color:'#111',fontSize:24}} name="arrow-back" />
                  </Text>
                </HStack>
      
                <HStack>
      
                <Text color="#555" fontSize="20" fontWeight="bold">
                تایید اس ام اس
                </Text>
                </HStack>
              </HStack>

      <ImageBackground 
        style={styles.loginBackground} 
        source={require('../assets/images/realstate-login-2.jpg')}
      >
        <View style={styles.contentContainer}>
          <Text style={styles.instructionText}>
           
            کد ۵ رقمی ارسال شده به شماره {"\n"}
            { phone }
            { ' را وارد کنید ' }
           
          </Text>

          <View style={styles.otpContainer}>
            <OTPInputView
              ref={otpInputRef}
              style={styles.otpInput}
              pinCount={5}
              code={code}
              onCodeChanged={setCode}
              autoFocusOnLoad
              codeInputFieldStyle={styles.underlineStyleBase}
              codeInputHighlightStyle={styles.underlineStyleHighLighted}
              onCodeFilled={handleVerifyCode}
              placeholderCharacter="-"
              placeholderTextColor="#999"
            />
          </View>

          {isLoading ? (
            <View style={styles.spinnerView}>
              <Spinner isVisible={true} size={30} type='Circle' color='#b92a31'/>
            </View>
          ) : (
            <Button
              style={styles.submitButton}
              onPress={handleVerifyCode}
              disabled={code.length !== 5}
            >
              <Text style={styles.buttonText}>تایید و ورود</Text>
            </Button>
          )}

          <TouchableOpacity 
            onPress={handleResendCode}
            style={styles.resendButton}
          >
            <Text style={styles.resendText}>کد را دریافت نکرده‌اید؟</Text>
            <Text style={[styles.resendText, { color: '#FF8C00', marginTop: 5 }]}>
              ارسال مجدد کد / تغییر شماره
            </Text>
          </TouchableOpacity>
        </View>
      </ImageBackground>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#fff'
  },
  loginBackground: {
    width: Dimensions.get('window').width,
    height: Dimensions.get('window').height,
    justifyContent: 'center',
    alignItems: 'center',
  },
  contentContainer: {
    width: '90%',
    backgroundColor: 'rgba(255,255,255,0.9)',
    borderRadius: 15,
    padding: 20,
    alignItems: 'center',
    shadowColor: "#000",
    shadowOffset: {
      width: 0,
      height: 2,
    },
    shadowOpacity: 0.25,
    shadowRadius: 3.84,
    elevation: 5,
  },
  backIcon: {
    color: '#333',
    fontSize: 24
  },
  headerTitle: {
    color: '#333',
    fontSize: 18,
    fontWeight: 'bold'
  },
  instructionText: {
    color: '#555',
    fontSize: 16,
    textAlign: 'center',
    marginBottom: 30,
    lineHeight: 25,
  },
  otpContainer: {
    width: '100%',
    height: 80,
    marginBottom: 20
  },
  otpInput: {
    width: '100%',
    height: 60
  },
  underlineStyleBase: {
    width: 50,
    height: 50,
    borderWidth: 1,
    borderColor: '#ddd',
    borderRadius: 8,
    color: '#333',
    fontSize: 20,
    backgroundColor: '#fff'
  },
  underlineStyleHighLighted: {
    borderColor: '#FF8C00',
  },
  submitButton: {
    width: '100%',
    borderRadius: 8,
    backgroundColor: '#FF8C00',
    height: 50,
    marginBottom: 15,
  },
  buttonText: {
    fontFamily: 'IRAN Sans',
    fontSize: 18,
  },
  resendButton: {
    marginTop: 15,
    alignItems: 'center'
  },
  resendText: {
    fontFamily: 'IRAN Sans',
    fontSize: 14,
    color: '#555'
  },
  spinnerView: {
    height: 70,
    justifyContent: 'center',
    alignItems: 'center',
    marginVertical: 10,
  },
});

export default Validation;