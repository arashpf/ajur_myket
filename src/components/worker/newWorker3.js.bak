        borderWidth: 2,
    },
    errorText: {
        color: '#D32F2F',
        fontSize: 12,
        marginTop: 5,
        textAlign: 'right',
    },
    buttonContainer: {
        marginTop: 20,
        marginBottom: 10,
    },
    submitButton: {
        backgroundColor: '#4CAF50',
